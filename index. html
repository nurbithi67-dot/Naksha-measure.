        <option value="shotok">শতক</option>
        <option value="katha">কাঠা</option>
        <option value="bigha">বিঘা</option>
        <option value="acre">একর</option>
        <option value="hectare">হেক্টর</option>
      </select>
    </div>
  </div>
  <div class="result" id="conv-result">
    <table>
      <tr><td>বর্গফুট</td><td id="c-sqft"></td></tr>
      <tr><td>বর্গমিটার</td><td id="c-sqm"></td></tr>
      <tr><td>শতক</td><td id="c-shotok"></td></tr>
      <tr><td>কাঠা</td><td id="c-katha"></td></tr>
      <tr><td>বিঘা</td><td id="c-bigha"></td></tr>
      <tr><td>একর</td><td id="c-acre"></td></tr>
      <tr><td>হেক্টর</td><td id="c-hectare"></td></tr>
    </table>
  </div>
</div>

<!-- ============ ইতিহাস ============ -->
<div class="card">
  <h2>গণনার ইতিহাস</h2>
  <p class="hint">সর্বশেষ ২০টি গণনা স্বয়ংক্রিয়ভাবে সংরক্ষিত থাকে</p>
  <div id="history-list"></div>
  <div class="row" style="margin-bottom:8px;margin-top:8px;">
    <div style="flex:1;">
      <label style="font-size:.8rem;">প্রিন্ট করবেন কতটি?</label>
      <select id="print-count" style="margin-bottom:0;">
        <option value="5">সর্বশেষ ৫টি</option>
        <option value="10" selected>সর্বশেষ ১০টি</option>
        <option value="20">সর্বশেষ ২০টি</option>
        <option value="all">সবগুলো</option>
      </select>
    </div>
  </div>
  <button class="btn-primary" style="margin-bottom:8px;" onclick="printAllHistory()">🖨️ সব PDF একসাথে</button>
  <button class="btn-clear" onclick="clearHistory()">🗑️ সব ইতিহাস মুছুন</button>
</div>

<script>
/* ================= ধ্রুবক ================= */
const SQM_PER_SHOTOK = 40.4686;
const SHOTOK_PER_KATHA = 1.65;
const KATHA_PER_BIGHA = 20;
const SHOTOK_PER_ACRE = 100;
const SQM_PER_ACRE = 4046.86;
const SQM_PER_HECTARE = 10000;
const SQM_PER_SQFT = 0.092903;
const LINK_TO_METER = 0.201168;
const SVG_NS = 'http://www.w3.org/2000/svg';

/* ================= হেল্পার ================= */
function num(id) { const v = parseFloat(document.getElementById(id).value); return isNaN(v) ? null : v; }
function fmt(n) {
  if (n === null || isNaN(n)) return '—';
  return n.toLocaleString('bn-BD', { maximumFractionDigits: 4 });
}
function showError(msg) { const e = document.getElementById('calc-error'); e.textContent = msg; e.classList.add('show'); }
function clearError() { document.getElementById('calc-error').classList.remove('show'); }
function hideResult() { document.getElementById('area-result').classList.remove('show'); clearError(); }
function heron(a, b, c) { const s = (a+b+c)/2; const val = s*(s-a)*(s-b)*(s-c); return val > 0 ? Math.sqrt(val) : NaN; }

/* ================= বাংলা তারিখ ================= */
const BN_MONTHS = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
const BN_DIGITS = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
function toBnDigits(str) { return String(str).replace(/[0-9]/g, d => BN_DIGITS[d]); }
function formatBanglaDate(date) {
  const day = toBnDigits(date.getDate());
  const month = BN_MONTHS[date.getMonth()];
  const year = toBnDigits(date.getFullYear());
  let h = date.getHours(); const m = date.getMinutes();
  const ampm = h >= 12 ? 'PM' : 'AM';
  h = h % 12; if (h === 0) h = 12;
  const timeStr = `${toBnDigits(h)}:${toBnDigits(String(m).padStart(2,'0'))} ${ampm}`;
  return `${day} ${month} ${year}, ${timeStr}`;
}
function displayTime(storedTime) {
  if (!storedTime) return '';
  const str = String(storedTime);
  if (/[অ-৯]/.test(str)) return str;
  const dateMatch = str.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if (!dateMatch) { const d = new Date(str); return isNaN(d) ? str : formatBanglaDate(d); }
  const day = parseInt(dateMatch[1],10);
  const monthIdx = parseInt(dateMatch[2],10) - 1;
  const year = parseInt(dateMatch[3],10);
  const timeMatch = str.match(/(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?/i);
  let hour = 0, minute = 0, ampm = '';
  if (timeMatch) {
    hour = parseInt(timeMatch[1],10); minute = parseInt(timeMatch[2],10);
    ampm = (timeMatch[4] || '').toUpperCase();
    if (!ampm) { if (hour >= 12) { ampm='PM'; if (hour>12) hour-=12; } else { ampm='AM'; if (hour===0) hour=12; } }
  }
  return `${toBnDigits(day)} ${BN_MONTHS[monthIdx]||''} ${toBnDigits(year)}, ${toBnDigits(hour)}:${toBnDigits(String(minute).padStart(2,'0'))} ${ampm}`;
}

/* ================= চিত্র (SVG) ================= */
function clearDiagram() {
  const svg = document.getElementById('diagram-svg');
  if (svg) while (svg.firstChild) svg.removeChild(svg.firstChild);
}
function svgEl(tag, attrs, text) {
  const el = document.createElementNS(SVG_NS, tag);
  for (const k in attrs) el.setAttribute(k, attrs[k]);
  if (text !== undefined) el.textContent = text;
  return el;
}
function fitPoints(pts, w, h, pad) {
  const xs = pts.map(p => p[0]), ys = pts.map(p => p[1]);
  const minX = Math.min(...xs), maxX = Math.max(...xs);
  const minY = Math.min(...ys), maxY = Math.max(...ys);
  const spanX = maxX - minX || 1, spanY = maxY - minY || 1;
  const scale = Math.min((w-2*pad)/spanX, (h-2*pad)/spanY);
  const offX = (w - spanX*scale)/2, offY = (h - spanY*scale)/2;
  return pts.map(([x,y]) => [offX + (x-minX)*scale, h - (offY + (y-minY)*scale)]);
}
function drawShape(points, edgeLabels, areaText) {
  clearDiagram();
  const svg = document.getElementById('diagram-svg');
  if (!svg) return;
  svg.setAttribute('style','-webkit-print-color-adjust:exact;print-color-adjust:exact;');
  const W = 320, H = 220, PAD = 30;
  const fitted = fitPoints(points, W, H, PAD);
  const d = fitted.map((p,i) => (i===0?'M':'L') + p[0] + ',' + p[1]).join(' ') + ' Z';
  svg.appendChild(svgEl('path', { d, fill:'rgba(47,133,90,.12)', stroke:'#2f855a', 'stroke-width':2 }));
  if (edgeLabels && edgeLabels.length === fitted.length) {
    for (let i = 0; i < fitted.length; i++) {
      const p1 = fitted[i], p2 = fitted[(i+1)%fitted.length];
      const mx = (p1[0]+p2[0])/2, my = (p1[1]+p2[1])/2;
      svg.appendChild(svgEl('text', { x:mx, y:my-6, 'text-anchor':'middle', 'font-size':'9', 'font-weight':'700', fill:'#1e4d2b' }, edgeLabels[i]));
    }
  }
  const cx = fitted.reduce((s,p)=>s+p[0],0)/fitted.length;
  const cy = fitted.reduce((s,p)=>s+p[1],0)/fitted.length;
  svg.appendChild(svgEl('text', { x:cx, y:cy+4, 'text-anchor':'middle', 'font-size':'9', 'font-weight':'800', fill:'#22543d' }, areaText));
}
function linkLabel(linkVal) { return `${fmt(linkVal)}L (${fmt(linkVal*0.66)}ft)`; }
function areaLabel(sqm) {
  const shotok = sqm / SQM_PER_SHOTOK;
  const katha = shotok / SHOTOK_PER_KATHA;
  return `${fmt(shotok)} শতাংশ (≈ ${fmt(katha)} কাঠা)`;
}
function trianglePoints(a, b, c) {
  const A = [0,0], B = [a,0];
  const x = (b*b + a*a - c*c)/(2*a);
  const y = Math.sqrt(Math.max(0, b*b - x*x));
  return [A, B, [x,y]];
}
function quadPoints(a, b, c, d, diag) {
  const A = [0,0], B = [a,0];
  const xC = (b*b + a*a - diag*diag)/(2*a);
  const yC = Math.sqrt(Math.max(0, b*b - xC*xC));
  const C = [xC, yC];
  const dx = C[0]-B[0], dy = C[1]-B[1];
  const distBC = Math.sqrt(dx*dx+dy*dy) || 1;
  const xD = (c*c - d*d + distBC*distBC)/(2*distBC);
  const yD = Math.sqrt(Math.max(0, c*c - xD*xD));
  const ux = dx/distBC, uy = dy/distBC;
  const px = -uy, py = ux;
  return [A, B, C, [B[0]+xD*ux+yD*px, B[1]+xD*uy+yD*py]];
}

