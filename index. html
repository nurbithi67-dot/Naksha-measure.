function calcLinkOffset() {
  const rows = document.querySelectorAll('#offset-list .coords-row');
  const data = [];
  rows.forEach(r => {
    const d = parseFloat(r.querySelector('.od').value);
    const o = parseFloat(r.querySelector('.oo').value);
    if (!isNaN(d) && !isNaN(o)) data.push({ d, o });
  });
  if (data.length < 2) {
    document.getElementById('link-error').textContent = 'কমপক্ষে ২টি বিন্দু দিন।';
    document.getElementById('link-error').classList.add('show'); return;
  }
  let areaLink = 0;
  for (let i = 0; i < data.length-1; i++) {
    const avgOff = (data[i].o + data[i+1].o)/2;
    const distLink = data[i+1].d - data[i].d;
    areaLink += avgOff * distLink;
  }
  const areaSqm = areaLink * LINK_TO_METER * LINK_TO_METER;
  document.getElementById('link-error').classList.remove('show');
  const dg = (sqm) => {
    clearDiagram();
    const svg = document.getElementById('diagram-svg');
    if (!svg) return;
    const W = 320, H = 220, PAD = 30;
    const totalDist = (data[data.length-1].d - data[0].d) || 1;
    const maxOff = Math.max(...data.map(p=>p.o)) || 1;
    const scaleX = (W-2*PAD)/totalDist, scaleY = (H-2*PAD)/(maxOff*1.2);
    const baseY = H-PAD;
    const xAt = d => PAD + (d-data[0].d)*scaleX;
    svg.appendChild(svgEl('line', { x1:PAD, y1:baseY, x2:W-PAD, y2:baseY, stroke:'#718096', 'stroke-width':2, 'stroke-dasharray':'4,3' }));
    const topPts = [];
    data.forEach(p => {
      const x = xAt(p.d), y = baseY - p.o*scaleY;
      topPts.push([x,y]);
      svg.appendChild(svgEl('line', { x1:x, y1:baseY, x2:x, y2:y, stroke:'#2f855a', 'stroke-width':1.5 }));
      svg.appendChild(svgEl('circle', { cx:x, cy:y, r:3, fill:'#2f855a' }));
      svg.appendChild(svgEl('text', { x:x+4, y:y-4, 'font-size':'8', fill:'#1e4d2b' }, linkLabel(p.o)));
    });
    const dPath = topPts.map((p,i)=>(i===0?'M':'L')+p[0]+','+p[1]).join(' ');
    svg.appendChild(svgEl('path', { d:dPath, fill:'none', stroke:'#2f855a', 'stroke-width':2 }));
    svg.appendChild(svgEl('text', { x:W/2, y:20, 'text-anchor':'middle', 'font-size':'10', 'font-weight':'800', fill:'#22543d' }, areaLabel(sqm)));
  };
  dg.diagramData = { type:'offset', points: data.map(p=>[p.d, p.o]) };
  showArea(areaSqm, 'লিংক অফসেট', `${data.length}টি বিন্দু`, dg);
}
function calcLinkTri() {
