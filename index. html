        <tr><td style="padding:4px 0;">কাঠা</td><td style="text-align:right;font-weight:700;">${fmt(katha)}</td></tr>
        <tr><td style="padding:4px 0;">বর্গফুট</td><td style="text-align:right;font-weight:700;">${fmt(h.sqft)}</td></tr>
        <tr><td style="padding:4px 0;">বর্গমিটার</td><td style="text-align:right;font-weight:700;">${fmt(h.sqm)}</td></tr>
        <tr><td style="padding:4px 0;">বিঘা</td><td style="text-align:right;font-weight:700;">${fmt(h.bigha)}</td></tr>
        <tr><td style="padding:4px 0;">একর</td><td style="text-align:right;font-weight:700;">${fmt(h.acre)}</td></tr>
      </table>
    </div>`;
  document.body.appendChild(printArea);
  if (h.diagram) drawDiagramInto('print-svg-box', h.diagram, h.sqm);
  window.print();
  setTimeout(() => printArea.remove(), 500);
}
function printAllHistory() {
  let history = loadHistory();
  if (history.length === 0) { alert('ইতিহাসে কোনো গণনা নেই।'); return; }
  const countVal = document.getElementById('print-count').value;
  if (countVal !== 'all') history = history.slice(0, parseInt(countVal));
  const printArea = document.createElement('div');
  printArea.id = 'print-area';
  const title = document.createElement('h2');
  title.textContent = 'ভূমি জরিপ ক্যালকুলেটর — ফলাফল';
  title.style.cssText = 'text-align:center;color:#1e4d2b;margin-bottom:4px;font-size:1.2rem;';
  printArea.appendChild(title);
  const date = document.createElement('p');
  date.textContent = `প্রিন্টের তারিখ: ${formatBanglaDate(new Date())} | মোট ${history.length}টি গণনা`;
  date.style.cssText = 'text-align:center;font-size:.8rem;color:#718096;margin-bottom:16px;';
  printArea.appendChild(date);
  history.forEach((h,idx) => {
    const shotok = h.sqm/SQM_PER_SHOTOK;
    const katha = shotok/SHOTOK_PER_KATHA;
    const block = document.createElement('div');
    block.style.cssText = 'background:#f0fff4;border:1.5px solid #9ae6b4;border-radius:8px;padding:12px;margin-bottom:14px;page-break-inside:avoid;';
    block.innerHTML = `
      <div style="border-bottom:1px solid #c6f6d5;padding-bottom:6px;margin-bottom:8px;">
        <div style="font-size:.95rem;font-weight:800;color:#2f855a;margin-bottom:2px;">📅 ${displayTime(h.time)}</div>
        <div style="display:flex;justify-content:space-between;align-items:baseline;">
          <div style="font-size:1rem;font-weight:800;color:#22543d;">${h.label}</div>
          <div style="font-size:.75rem;color:#718096;">${h.detail}</div>
        </div>
      </div>
      <div class="svg-holder" data-idx="${idx}" style="text-align:center;margin-bottom:8px;"></div>
      <table style="width:100%;font-size:.8rem;border-collapse:collapse;">
        <tr><td style="padding:3px 0;">শতাংশ</td><td style="text-align:right;font-weight:700;">${fmt(shotok)}</td></tr>
        <tr><td style="padding:3px 0;">কাঠা</td><td style="text-align:right;font-weight:700;">${fmt(katha)}</td></tr>
        <tr><td style="padding:3px 0;">বর্গফুট</td><td style="text-align:right;font-weight:700;">${fmt(h.sqft)}</td></tr>
        <tr><td style="padding:3px 0;">বর্গমিটার</td><td style="text-align:right;font-weight:700;">${fmt(h.sqm)}</td></tr>
        <tr><td style="padding:3px 0;">বিঘা</td><td style="text-align:right;font-weight:700;">${fmt(h.bigha)}</td></tr>
        <tr><td style="padding:3px 0;">একর</td><td style="text-align:right;font-weight:700;">${fmt(h.acre)}</td></tr>
      </table>`;
    printArea.appendChild(block);
  });
  document.body.appendChild(printArea);
  history.forEach((h,idx) => {
    if (h.diagram) {
      const holder = printArea.querySelector(`.svg-holder[data-idx="${idx}"]`);
      if (holder) { holder.id = 'all-svg-' + idx; drawDiagramInto('all-svg-' + idx, h.diagram, h.sqm); }
    }
  });
  window.print();
  setTimeout(() => printArea.remove(), 500);
}

/* ================= ট্যাব ================= */
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const card = tab.closest('.card');
    card.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    card.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    tab.classList.add('active');
    const target = card.querySelector('#sec-' + tab.dataset.tab);
    if (target) target.classList.add('active');
    hideResult();
  });
});

/* ================= বিন্দু ================= */
function addCoord() {
  const count = document.querySelectorAll('#coord-list .coords-row').length + 1;
  const div = document.createElement('div');
  div.className = 'coords-row';
  div.innerHTML = `
    <span>বিন্দু ${count}</span>
    <input type="number" step="any" placeholder="x" class="cx">
    <input type="number" step="any" placeholder="y" class="cy">
    <button class="btn-small" onclick="this.parentNode.remove()">✕</button>`;
  document.getElementById('coord-list').appendChild(div);
}
addCoord(); addCoord(); addCoord();

