function drawDiagramInto(containerId, data, sqm) {
  const box = document.getElementById(containerId);
  if (!box) return;
  const svg = document.createElementNS(SVG_NS, 'svg');
  svg.setAttribute('width','100%');
  svg.setAttribute('height','200');
  svg.setAttribute('viewBox','0 0 320 200');
  svg.setAttribute('style','max-width:360px;-webkit-print-color-adjust:exact;print-color-adjust:exact;');
  box.appendChild(svg);
  const W = 320, H = 200, PAD = 30;
  const areaText = areaLabel(sqm);
  if (data.type === 'poly' && data.points) {
    const fitted = fitPoints(data.points, W, H, PAD);
    const d = fitted.map((p,i)=>(i===0?'M':'L')+p[0]+','+p[1]).join(' ')+' Z';
    svg.appendChild(svgEl('path', { d, fill:'rgba(47,133,90,.12)', stroke:'#2f855a', 'stroke-width':2 }));
    if (data.labels && data.labels.length === fitted.length) {
      for (let i = 0; i < fitted.length; i++) {
        const p1 = fitted[i], p2 = fitted[(i+1)%fitted.length];
        const mx = (p1[0]+p2[0])/2, my = (p1[1]+p2[1])/2;
        svg.appendChild(svgEl('text', { x:mx, y:my-6, 'text-anchor':'middle', 'font-size':'9', 'font-weight':'700', fill:'#1e4d2b' }, data.labels[i]));
      }
    }
    const cx = fitted.reduce((s,p)=>s+p[0],0)/fitted.length;
    const cy = fitted.reduce((s,p)=>s+p[1],0)/fitted.length;
    svg.appendChild(svgEl('text', { x:cx, y:cy+4, 'text-anchor':'middle', 'font-size':'9', 'font-weight':'800', fill:'#22543d' }, areaText));
  } else if (data.type === 'offset' && data.points) {
    const totalDist = (data.points[data.points.length-1][0]-data.points[0][0]) || 1;
    const maxOff = Math.max(...data.points.map(p=>p[1])) || 1;
    const scaleX = (W-2*PAD)/totalDist, scaleY = (H-2*PAD)/(maxOff*1.2);
    const baseY = H-PAD;
    const xAt = d => PAD + (d-data.points[0][0])*scaleX;
    svg.appendChild(svgEl('line', { x1:PAD, y1:baseY, x2:W-PAD, y2:baseY, stroke:'#718096', 'stroke-width':2, 'stroke-dasharray':'4,3' }));
    const topPts = [];
    data.points.forEach(([dd,oo]) => {
      const x = xAt(dd), y = baseY - oo*scaleY;
      topPts.push([x,y]);
      svg.appendChild(svgEl('line', { x1:x, y1:baseY, x2:x, y2:y, stroke:'#2f855a', 'stroke-width':1.5 }));
      svg.appendChild(svgEl('circle', { cx:x, cy:y, r:3, fill:'#2f855a' }));
      svg.appendChild(svgEl('text', { x:x+4, y:y-4, 'font-size':'8', fill:'#1e4d2b' }, linkLabel(oo)));
    });
    const dPath = topPts.map((p,i)=>(i===0?'M':'L')+p[0]+','+p[1]).join(' ');
    svg.appendChild(svgEl('path', { d:dPath, fill:'none', stroke:'#2f855a', 'stroke-width':2 }));
    svg.appendChild(svgEl('text', { x:W/2, y:16, 'text-anchor':'middle', 'font-size':'10', 'font-weight':'800', fill:'#22543d' }, areaText));
  }
}
