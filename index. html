function calcTriangle() {
  const a = num('tri-a'), b = num('tri-b'), c = num('tri-c');
  if (!a || !b || !c) { showError('তিনটি বাহুর মান দিন।'); return; }
  if (a+b<=c || a+c<=b || b+c<=a) { showError('ত্রিভুজের অসমতা মেনে চলুন।'); return; }
  const area = heron(a,b,c);
  const toLink = m => m/LINK_TO_METER;
  const pts = trianglePoints(a,b,c);
  const labels = ['a='+linkLabel(toLink(a)), 'c='+linkLabel(toLink(c)), 'b='+linkLabel(toLink(b))];
  const dg = (sqm) => drawShape(pts, labels, areaLabel(sqm));
  dg.diagramData = { type:'poly', points:pts, labels };
  showArea(area, 'ত্রিভুজ', `বাহু: ${a}, ${b}, ${c} মিটার`, dg);
}
function calcQuad() {
  const a = num('q-a'), b = num('q-b'), c = num('q-c'), d = num('q-d'), diag = num('q-diag');
  if (!a||!b||!c||!d||!diag) { showError('চার বাহু ও কর্ণের মান দিন।'); return; }
  const t1 = heron(a,b,diag), t2 = heron(c,d,diag);
  if (isNaN(t1)||isNaN(t2)) { showError('কর্ণের মান দিয়ে ত্রিভুজ গঠন হচ্ছে না।'); return; }
  const toLink = m => m/LINK_TO_METER;
  const pts = quadPoints(a,b,c,d,diag);
  const labels = ['a='+linkLabel(toLink(a)),'b='+linkLabel(toLink(b)),'c='+linkLabel(toLink(c)),'d='+linkLabel(toLink(d))];
  const dg = (sqm) => drawShape(pts, labels, areaLabel(sqm));
  dg.diagramData = { type:'poly', points:pts, labels };
  showArea(t1+t2, 'চতুর্ভুজ', `বাহু: ${a}, ${b}, ${c}, ${d} | কর্ণ: ${diag}`, dg);
}
function calcPoly() {
  const rows = document.querySelectorAll('#coord-list .coords-row');
  const pts = [];
  rows.forEach(r => {
    const x = parseFloat(r.querySelector('.cx').value);
    const y = parseFloat(r.querySelector('.cy').value);
    if (!isNaN(x) && !isNaN(y)) pts.push([x,y]);
  });
  if (pts.length < 3) { showError('কমপক্ষে ৩টি বিন্দুর স্থানাঙ্ক দিন।'); return; }
  let sum = 0;
  for (let i = 0; i < pts.length; i++) {
    const [x1,y1] = pts[i], [x2,y2] = pts[(i+1)%pts.length];
    sum += (x1*y2 - x2*y1);
  }
  const area = Math.abs(sum)/2;
  const dg = (sqm) => drawShape(pts, null, areaLabel(sqm));
  dg.diagramData = { type:'poly', points:pts, labels:null };
  showArea(area, 'বহুভুজ', `${pts.length}টি বিন্দুর স্থানাঙ্ক`, dg);
}

