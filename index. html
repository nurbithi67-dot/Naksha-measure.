function calcLinkAngle() {
  const a = parseFloat(document.getElementById('la-a').value);
  const b = parseFloat(document.getElementById('la-b').value);
  const deg = parseFloat(document.getElementById('la-angle').value);
  if ([a,b,deg].some(v=>isNaN(v))) {
    document.getElementById('link-error').textContent = 'দুই বাহু ও কোণ দিন।';
    document.getElementById('link-error').classList.add('show'); return;
  }
  const areaLink = 0.5*a*b*Math.sin(deg*Math.PI/180);
  const areaSqm = areaLink * LINK_TO_METER * LINK_TO_METER;
  document.getElementById('link-error').classList.remove('show');
  const pts = (() => {
    const A = [0,0], B = [a,0];
    const rad = deg*Math.PI/180;
    return [A, B, [b*Math.cos(rad), b*Math.sin(rad)]];
  })();
  const labels = ['a='+linkLabel(a),'c=?','b='+linkLabel(b)];
  const dg = (sqm) => drawShape(pts, labels, areaLabel(sqm));
  dg.diagramData = { type:'poly', points:pts, labels };
  showArea(areaSqm, 'লিংক বাহু+কোণ', `বাহু: ${a}, ${b} | কোণ: ${deg}°`, dg);
}

