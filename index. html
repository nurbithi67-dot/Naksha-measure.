<!DOCTYPE html> 
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ভূমি জরিপ ক্যালকুলেটর</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#2f855a">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', 'Noto Sans Bengali', sans-serif;
    background: #f0f4f8; color: #1a202c; padding: 16px;
    max-width: 720px; margin: 0 auto; line-height: 1.6;
  }
  h1 { font-size: 1.4rem; text-align: center; color: #1e4d2b; margin-bottom: 4px; }
  .sub { text-align: center; font-size: .85rem; color: #4a5568; margin-bottom: 16px; }
  .card {
    background: #fff; border-radius: 12px; padding: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,.08); margin-bottom: 16px;
  }
  .card h2 { font-size: 1rem; color: #1e4d2b; margin-bottom: 12px; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; }
  label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 4px; color: #2d3748; }
  input, select {
    width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e0;
    border-radius: 8px; font-size: 1rem; margin-bottom: 10px;
    background: #f9fafb; transition: border .2s;
  }
  input:focus, select:focus { outline: none; border-color: #38a169; background: #fff; }
  .row { display: flex; gap: 10px; }
  .row > div { flex: 1; }
  button {
    width: 100%; padding: 12px; border: none; border-radius: 8px;
    font-size: 1rem; font-weight: 700; cursor: pointer; transition: .2s;
  }
  .btn-primary { background: #2f855a; color: #fff; }
  .btn-primary:hover { background: #276749; }
  .btn-clear { background: #edf2f7; color: #4a5568; margin-top: 8px; }
  .btn-clear:hover { background: #e2e8f0; }
  .result {
    background: #f0fff4; border: 1.5px solid #9ae6b4;
    border-radius: 8px; padding: 12px; margin-top: 12px; display: none;
  }
  .result.show { display: block; }
  .result .big { font-size: 1.3rem; font-weight: 800; color: #22543d; }
  .result table { width: 100%; margin-top: 8px; font-size: .85rem; border-collapse: collapse; }
  .result td { padding: 4px 0; border-bottom: 1px dashed #c6f6d5; }
  .result td:last-child { text-align: right; font-weight: 700; color: #22543d; }
  .tabs { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
  .tab {
    flex: 1; min-width: 80px; padding: 8px 6px; text-align: center;
    background: #edf2f7; border-radius: 8px; cursor: pointer;
    font-size: .8rem; font-weight: 700; color: #4a5568; transition: .2s;
  }
  .tab.active { background: #2f855a; color: #fff; }
  .section { display: none; }
  .section.active { display: block; }
  .hint { font-size: .75rem; color: #718096; margin-bottom: 10px; }
  .error { color: #c53030; font-size: .8rem; margin-top: 6px; display: none; }
  .error.show { display: block; }
  .coords-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
  .coords-row span { font-size: .8rem; width: 50px; color: #4a5568; font-weight: 600; }
  .coords-row input { margin-bottom: 0; }
  .btn-small { width: auto; padding: 6px 12px; font-size: .8rem; background: #edf2f7; color: #4a5568; border-radius: 6px; }
  @media print {
    body * { visibility: hidden; }
    #print-area, #print-area * { visibility: visible; }
    #print-area { position: absolute; left: 0; top: 0; width: 100%; padding: 20px; background: #fff; }
    #print-area > div { page-break-inside: avoid; }
    .no-print { display: none !important; }
  }
</style>
</head>
<body>

<h1>🏞️ ভূমি জরিপ ক্যালকুলেটর</h1>
<p class="sub">জমির ক্ষেত্রফল ও একক রূপান্তর</p>

<!-- ============ ক্ষেত্রফল গণনা ============ -->
<div class="card">
  <h2>ক্ষেত্রফল গণনা</h2>
  <div class="tabs">
    <div class="tab active" data-tab="tri">ত্রিভুজ</div>
    <div class="tab" data-tab="quad">চতুর্ভুজ</div>
    <div class="tab" data-tab="poly">বহুভুজ</div>
  </div>

  <div class="section active" id="sec-tri">
    <p class="hint">তিন বাহুর দৈর্ঘ্য দিন (মিটারে) — হারনের সূত্র ব্যবহার হবে</p>
    <label>বাহু a (মিটার)</label>
    <input type="number" id="tri-a" step="any" placeholder="যেমন ৩০">
    <label>বাহু b (মিটার)</label>
    <input type="number" id="tri-b" step="any" placeholder="যেমন ৪০">
    <label>বাহু c (মিটার)</label>
    <input type="number" id="tri-c" step="any" placeholder="যেমন ৫০">
    <button class="btn-primary" onclick="calcTriangle()">হিসাব করুন</button>
  </div>

  <div class="section" id="sec-quad">
    <p class="hint">একটি কর্ণ দিয়ে দুটি ত্রিভুজে ভাগ করে গণনা হবে</p>
    <div class="row">
      <div><label>বাহু a</label><input type="number" id="q-a" step="any" placeholder="মিটার"></div>
      <div><label>বাহু b</label><input type="number" id="q-b" step="any" placeholder="মিটার"></div>
    </div>
    <div class="row">
      <div><label>বাহু c</label><input type="number" id="q-c" step="any" placeholder="মিটার"></div>
      <div><label>বাহু d</label><input type="number" id="q-d" step="any" placeholder="মিটার"></div>
    </div>
    <label>কর্ণ (দুই কোণার মধ্যে দূরত্ব)</label>
    <input type="number" id="q-diag" step="any" placeholder="মিটার">
    <button class="btn-primary" onclick="calcQuad()">হিসাব করুন</button>
  </div>

  <div class="section" id="sec-poly">
    <p class="hint">প্রতিটি কোণার (x, y) স্থানাঙ্ক দিন — শু-লেস ফর্মুলা ব্যবহার হবে</p>
    <div id="coord-list"></div>
    <button class="btn-small" onclick="addCoord()">+ নতুন বিন্দু</button>
    <button class="btn-primary" style="margin-top:10px" onclick="calcPoly()">হিসাব করুন</button>
  </div>

  <div class="error" id="calc-error"></div>

  <div class="result" id="area-result">
    <div class="big" id="area-main"></div>
    <table>
      <tr><td>বর্গফুট</td><td id="r-sqft"></td></tr>
      <tr><td>বর্গমিটার</td><td id="r-sqm"></td></tr>
      <tr><td>শতক</td><td id="r-shotok"></td></tr>
      <tr><td>কাঠা</td><td id="r-katha"></td></tr>
      <tr><td>বিঘা</td><td id="r-bigha"></td></tr>
      <tr><td>একর</td><td id="r-acre"></td></tr>
    </table>
    <div id="diagram-box" style="margin-top:12px;text-align:center;">
      <svg id="diagram-svg" width="100%" height="220" viewBox="0 0 320 220" style="max-width:400px;"></svg>
    </div>
    <button class="btn-clear" style="margin-top:10px;" onclick="printResult()">🖨️ প্রিন্ট / PDF</button>
  </div>
</div>

<!-- ============ লিংক স্কেল (মৌজা নকশা) ============ -->
<div class="card">
  <h2>লিংক স্কেল (মৌজা নকশা)</h2>
  <label>নকশার স্কেল</label>
  <select id="map-scale" onchange="updateScaleInfo()">
    <option value="16" selected>১৬" = ১ মাইল (গুনিয়া ১ ছোট ঘর = ১০ লিংক)</option>
    <option value="32">৩২" = ১ মাইল (গুনিয়া ১ ছোট ঘর = ৫ লিংক)</option>
    <option value="64">৬৪" = ১ মাইল (গুনিয়া ১ ছোট ঘর = ২.৫ লিংক)</option>
    <option value="80">৮০" = ১ মাইল (গুনিয়া ১ ছোট ঘর = ২ লিংক)</option>
  </select>
  <p class="hint" id="scale-info">সরাসরি লিংক সংখ্যা ইনপুট করুন (গুনিয়া স্কেলের পাঠ অনুযায়ী)</p>

  <div class="tabs">
    <div class="tab active" data-tab="link-offset">অফসেট</div>
    <div class="tab" data-tab="link-tri">ত্রিভুজ লিংক</div>
    <div class="tab" data-tab="link-angle">দুই বাহু+কোণ</div>
  </div>

  <div class="section active" id="sec-link-offset">
    <p class="hint">বেস লাইন বরাবর দূরত্ব এবং সংশ্লিষ্ট অফসেট (সবই লিংক সংখ্যা) ইনপুট করুন</p>
    <div id="offset-list"></div>
    <button class="btn-small" onclick="addOffset()">+ নতুন অফসেট</button>
    <button class="btn-primary" style="margin-top:10px" onclick="calcLinkOffset()">হিসাব করুন</button>
  </div>

  <div class="section" id="sec-link-tri">
    <p class="hint">তিন বাহুর লিংক সংখ্যা ইনপুট করুন</p>
    <div class="row">
      <div><label>বাহু a (লিংক)</label><input type="number" id="lt-a" step="any" placeholder="লিংক সংখ্যা"></div>
      <div><label>বাহু b (লিংক)</label><input type="number" id="lt-b" step="any" placeholder="লিংক সংখ্যা"></div>
    </div>
    <label>বাহু c (লিংক)</label>
    <input type="number" id="lt-c" step="any" placeholder="লিংক সংখ্যা">
    <button class="btn-primary" onclick="calcLinkTri()">হিসাব করুন</button>
  </div>

  <div class="section" id="sec-link-angle">
    <p class="hint">দুই বাহুর লিংক সংখ্যা এবং মধ্যবর্তী কোণ (ডিগ্রি) ইনপুট করুন</p>
    <div class="row">
      <div><label>বাহু a (লিংক)</label><input type="number" id="la-a" step="any" placeholder="লিংক সংখ্যা"></div>
      <div><label>বাহু b (লিংক)</label><input type="number" id="la-b" step="any" placeholder="লিংক সংখ্যা"></div>
    </div>
    <label>মধ্যবর্তী কোণ (ডিগ্রি)</label>
    <input type="number" id="la-angle" step="any" placeholder="যেমন ৯০">
    <button class="btn-primary" onclick="calcLinkAngle()">হিসাব করুন</button>
  </div>

  <div class="error" id="link-error"></div>
</div>

<!-- ============ একক রূপান্তর ============ -->
<div class="card">
  <h2>একক রূপান্তর</h2>
  <div class="row">
    <div>
      <label>মান</label>
      <input type="number" id="conv-val" step="any" placeholder="০" oninput="doConvert()">
    </div>
    <div>
      <label>একক</label>
      <select id="conv-unit" onchange="doConvert()">
        <option value="sqm">বর্গমিটার</option>
